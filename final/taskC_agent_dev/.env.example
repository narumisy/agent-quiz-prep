# 复制本文件为 .env 并填入你的真实配置
# 不配置时自动进入模拟模式，无网络也能跑通整套 RAG 流程

# 大模型 API Key（必填才启用真实模型；支持百炼 / DeepSeek / OpenAI 等 OpenAI 兼容接口）
USER_LLM_API_KEY=your-api-key-here

# OpenAI 兼容接口地址（默认阿里云百炼 DashScope）
USER_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 对话模型名（百炼：qwen-plus / qwen-max；DeepSeek：deepseek-chat；OpenAI：gpt-4o-mini）
USER_LLM_MODEL=qwen-plus

# 视觉模型名（多模态图片识别，如百炼 qwen-vl-plus / qwen-vl-max；OpenAI gpt-4o）
USER_VISION_MODEL=qwen-vl-plus

# 向量化模型名（百炼 text-embedding-v3 / text-embedding-v1）
USER_EMBED_MODEL=text-embedding-v3
